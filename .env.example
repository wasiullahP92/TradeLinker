# Supabase Project Configuration
# Found in Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Optional: Supabase Service Role Key (Used for Backend Administrative Webhooks ONLY)
# NEVER expose this key in client-side code!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Platform Application Settings
VITE_APP_NAME="TradeLinker"
VITE_APP_URL="https://tradelinker.vercel.app"
VITE_SUPPORT_EMAIL="support@tradelinker.com"

# Storage Bucket Names
VITE_SUPABASE_STORAGE_DOCUMENTS="provider-verification-documents"
VITE_SUPABASE_STORAGE_AVATARS="user-avatars"
